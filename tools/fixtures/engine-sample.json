        ["$DATE", "google-ads", "Xero US", "2", "LD - Shoes - NB", "SEARCH", "STANDARD", "Non-Brand",
         {"scale": 9200}, {"scale": 430}, {"scale": 840}, {"scale": 17}, {"scale": 2100}, 0.21],
